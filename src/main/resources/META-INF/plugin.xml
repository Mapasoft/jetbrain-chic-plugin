<idea-plugin>
    <id>com.chic.clion-plugin</id>
    <name>Chic Language</name>
    <vendor>Chic Compiler Team</vendor>
    <description><![CDATA[
        CLion support for the <b>Chic</b> programming language.<br/>
        <ul>
            <li>Syntax highlighting for keywords, declarations, types, literals, strings, comments, and operators</li>
            <li>Semantic highlighting for user-defined types, enum cases, constants, decorators, and generic type arguments</li>
            <li>Brace and bracket matching with code folding for blocks and block comments</li>
            <li>Project-level Chic run configuration using the CLion project root as the Chic project root</li>
            <li>Automatic compiler discovery from <code>CHIC_DIR/bin/chic</code>, plugin settings, PATH, or an optional override</li>
            <li>Build action that invokes <code>chic build</code> and maps compiler diagnostics to clickable source locations</li>
            <li>Debug action that builds with <code>-g</code>, launches CLion's native debugger, and supports Chic source breakpoints</li>
            <li>Separate fields for compiler arguments and compiled-program arguments, including debug launch argument forwarding</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.nativeDebug</depends>
    <depends>com.intellij.clion</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ── File type ─────────────────────────────────────────────── -->
        <fileType
            name="Chic"
            implementationClass="com.chic.ChicFileType"
            fieldName="INSTANCE"
            language="Chic"
            extensions="chic"/>

        <!-- ── Syntax highlighting ────────────────────────────────────── -->
        <lang.syntaxHighlighterFactory
            language="Chic"
            implementationClass="com.chic.highlighting.ChicSyntaxHighlighterFactory"/>

        <!-- ── Semantic highlighting (Rust-flavored: types, variants, constants, decorators) ── -->
        <annotator
            language="Chic"
            implementationClass="com.chic.highlighting.ChicSemanticAnnotator"/>

        <!-- ── Parser (required for PSI tree / colour attributes) ──────── -->
        <lang.parserDefinition
            language="Chic"
            implementationClass="com.chic.parser.ChicParserDefinition"/>

        <!-- ── Brace matching ─────────────────────────────────────────── -->
        <lang.braceMatcher
            language="Chic"
            implementationClass="com.chic.editor.ChicBraceMatcher"/>

        <!-- ── Code folding ───────────────────────────────────────────── -->
        <lang.foldingBuilder
            language="Chic"
            implementationClass="com.chic.editor.ChicFoldingBuilder"/>

        <!-- ── Run configuration ─────────────────────────────────────── -->
        <configurationType
            implementation="com.chic.run.ChicRunConfigurationType"/>
        <programRunner
            implementation="com.chic.run.ChicDebugProgramRunner"/>
        <runConfigurationProducer
            implementation="com.chic.run.ChicRunConfigurationProducer"/>
        <notificationGroup
            id="Chic"
            displayType="BALLOON"/>

        <!-- ── Settings page ─────────────────────────────────────────── -->
        <projectConfigurable
            parentId="tools"
            instance="com.chic.settings.ChicSettingsConfigurable"
            id="com.chic.settings"
            displayName="Chic"/>

    </extensions>

    <extensions defaultExtensionNs="cidr.debugger">
        <languageSupport
            language="Chic"
            implementationClass="com.chic.debug.ChicDebuggerLanguageSupport"/>
        <lineBreakpointFileTypesProvider
            implementation="com.chic.debug.ChicCidrBreakpointFileTypesProvider"/>
    </extensions>

    <actions>
        <action
            id="com.chic.run.RunChicFile"
            class="com.chic.run.RunChicFileAction"
            text="Build Chic Project"
            description="Build the current Chic project">
            <keyboard-shortcut keymap="$default" first-keystroke="F7"/>
            <add-to-group group-id="BuildMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
        <action
            id="com.chic.run.DebugChicFile"
            class="com.chic.run.DebugChicFileAction"
            text="Debug Chic Project"
            description="Build the current Chic project with debug info and launch CLion's native debugger">
            <add-to-group group-id="BuildMenu" anchor="after" relative-to-action="com.chic.run.RunChicFile"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
